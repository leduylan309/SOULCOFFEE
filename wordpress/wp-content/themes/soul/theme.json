{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "100%"
    },
    "useRootPaddingAwareAlignments": true,
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "ink", "name": "Ink", "color": "#27292D" },
        { "slug": "ink-deep", "name": "Ink Deep", "color": "#1E1F22" },
        { "slug": "paper", "name": "Paper", "color": "#F4EFE5" },
        { "slug": "sand", "name": "Sand", "color": "#EAE3D5" },
        { "slug": "sand-deep", "name": "Sand Deep", "color": "#E2DACB" },
        { "slug": "yellow", "name": "Soul Yellow", "color": "#FFD35B" },
        { "slug": "clay", "name": "Clay", "color": "#8E4B33" },
        { "slug": "stone-700", "name": "Stone 700", "color": "#514B42" },
        { "slug": "stone-500", "name": "Stone 500", "color": "#7C7365" },
        { "slug": "white", "name": "White", "color": "#FFFFFF" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "display",
          "name": "Newsreader",
          "fontFamily": "Newsreader, Georgia, serif"
        },
        {
          "slug": "sans",
          "name": "Be Vietnam Pro",
          "fontFamily": "\"Be Vietnam Pro\", system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "12.5px" },
        { "slug": "body", "name": "Body", "size": "15px" },
        { "slug": "lead", "name": "Lead", "size": "clamp(19px, 1.6vw, 23px)" },
        { "slug": "title", "name": "Title", "size": "23px" },
        { "slug": "h2", "name": "H2", "size": "clamp(34px, 4.2vw, 60px)" },
        { "slug": "hero", "name": "Hero", "size": "clamp(46px, 6.2vw, 100px)" }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "%", "vw", "vh"]
    },
    "border": {
      "radius": false
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--paper)",
      "text": "var(--wp--preset--color--ink)"
    },
    "spacing": {
      "blockGap": "0"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.7"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "400",
          "lineHeight": "1.05"
        }
      },
      "link": {
        "color": { "text": "var(--wp--preset--color--ink)" },
        ":hover": {
          "color": { "text": "var(--wp--preset--color--clay)" }
        }
      },
      "button": {
        "border": { "radius": "0" },
        "color": {
          "background": "var(--wp--preset--color--ink)",
          "text": "var(--wp--preset--color--paper)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--sans)",
          "fontSize": "12.5px",
          "fontWeight": "500",
          "letterSpacing": "0.12em",
          "textTransform": "uppercase"
        }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ]
}
